# --- Application ---------------------------------------------------------------
# Unlike the Docker / Sail section below, an empty value here is NOT a default:
# Laravel reads it as an empty string. Comment a line out to use the config default.

APP_NAME=Laravel
APP_ENV=local

# Application encryption key, generated by scripts/sail/setup.sh.
APP_KEY=
APP_DEBUG=true

# Keep the port in sync with APP_PORT: used for URLs built outside HTTP requests
# (Artisan commands, queued jobs, links in emails).
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# Workers of the PHP built-in server started by `artisan serve`.
# It serves one request at a time; uncomment to handle concurrent requests.
# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# --- Logging -------------------------------------------------------------------

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database (mysql service) ----------------------------------------------------
# Host and port inside the Docker network. From your machine (e.g. a database
# client) use 127.0.0.1 and FORWARD_DB_PORT instead.

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=sail
DB_PASSWORD=password

# --- Session, queue and cache ----------------------------------------------------
# The redis driver talks to the valkey service.
# Queued jobs run only while a worker is active: `./sail artisan queue:work`.
# Without valkey in COMPOSE_PROFILES, set CACHE_STORE and QUEUE_CONNECTION to database.

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

# Not used: the boilerplate has no Memcached service.
MEMCACHED_HOST=127.0.0.1

# --- Redis / Valkey (valkey service) ---------------------------------------------
# Host and port inside the Docker network. From your machine use 127.0.0.1 and
# FORWARD_VALKEY_PORT instead.

REDIS_CLIENT=phpredis
REDIS_HOST=valkey
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Mail (mailpit service) ------------------------------------------------------
# Every email is caught by Mailpit: open http://localhost:8025 to read them.
# Without mailpit in COMPOSE_PROFILES, set MAIL_MAILER=log.

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- AWS (optional) ----------------------------------------------------------------
# Only needed for S3 disks, SES or SQS.

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Vite ----------------------------------------------------------------------------

VITE_APP_NAME="${APP_NAME}"

# --- Docker / Sail -------------------------------------------------------------------
# Empty values fall back to the defaults written in compose.yaml (${VAR:-default}).

# Name of the application service in compose.yaml (Sail would default to laravel.test).
APP_SERVICE=app

# Host interface the ports are bound to. Empty: 127.0.0.1, reachable only from this machine.
APP_BIND_ADDRESS=

# Host port of the application. Keep it in sync with APP_URL.
APP_PORT=8080

# Host port of the Vite dev server. Empty: 5173.
VITE_PORT=

# Host ports of MySQL and Valkey. Empty: Docker picks a free random port, so several
# projects can run at the same time. Find it with `./sail port mysql 3306`;
# set a fixed value if your database client needs a stable port.
FORWARD_DB_PORT=
FORWARD_VALKEY_PORT=

# Host port of the Mailpit dashboard. Empty: 8025.
FORWARD_MAILPIT_DASHBOARD_PORT=

# Host user uid/gid. Sail computes them on its own; scripts/sail/setup.sh writes
# them for tools that run docker compose directly.
WWWUSER=
WWWGROUP=

# --- Docker image ----------------------------------------------------------------------
# Changing any of these rebuilds most of the app image (a few minutes): run `./sail build`.

# PHP runtime: 8.3, 8.4 or 8.5 (folders in docker/).
PHP_VERSION=8.5

# Node.js major version. Empty: 24.
NODE_VERSION=

# Exact Composer version (e.g. 2.8.4). Empty: latest release.
COMPOSER_VERSION=

# Extra PHP extensions, space separated, installed as php<version>-<name> packages
# (e.g. "imagick swoole"). Empty: none.
PHP_EXTENSIONS=

# --- Services --------------------------------------------------------------------------
# Docker image tags. Empty: MySQL 8.4, Valkey 9, Mailpit latest.
# Do not downgrade MySQL on an existing volume: run `./sail down -v` first.

# Optional services to start, comma separated: valkey, mailpit. The app and MySQL always run.
# Unlike the rest of this section, an empty value means no optional service at all.
# When you turn one off, update the Laravel settings that use it (see the cache and mail
# sections above). Run `./sail down` before changing this value, then `./sail up -d --wait`.
COMPOSE_PROFILES=valkey,mailpit

MYSQL_VERSION=
VALKEY_VERSION=
MAILPIT_VERSION=
